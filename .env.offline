# `npm run dev:offline` 전용 (Vite mode "offline").
# 서버 저장(Firebase)을 끄고 이 브라우저에만 저장한다 — 실제 수업 서버의 학생 · 진행도를 건드리지 않고 시험할 때 쓴다.
# .env.local 의 VITE_FIREBASE_* 보다 이 파일이 먼저라, 값을 비워 두면 서버 저장이 꺼진다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
