# 유료 이미지 생성(OpenAI API) — `npm run art -- --engine api` 로 만들 때만 쓴다.
# 기본(Codex, ChatGPT 구독)으로 만들 때는 필요 없다.
#
# ⚠ 이름 앞에 VITE_ 를 붙이지 않는다. VITE_ 값은 학생 브라우저로 내려가는 파일에 그대로 들어간다.
#   이 키는 scripts/ 의 생성 스크립트만 읽고, 게임 번들에는 들어가지 않는다.
#
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 선생님 화면(/teacher.html) 암호
#
# ⚠ 보안 장치가 아니다. 이 값은 브라우저로 내려가는 파일 안에 그대로 들어간다.
#   학생이 주소를 눌러 우연히 들어오는 것을 막는 정도로만 쓴다.
# 비워 두면 암호 없이 바로 열린다.
VITE_TEACHER_PASSCODE=

# 서버 저장 (Firebase) — 2D 판(googoodan)과 같은 프로젝트를 쓴다. 3D 판은 players3d · saves3d · stats3d 컬렉션에 따로 저장한다.
# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 의 firebaseConfig 값. 이 값들은 브라우저에 내려가도 되는 공개 설정이다.
# (접근은 익명 로그인 + 보안 규칙 firestore.rules 로 막는다)
# 하나라도 비어 있으면 서버 없이 이 기기(localStorage)에만 저장한다.
# Netlify 배포에는 사이트 설정 → Environment variables 에 같은 이름으로 넣는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
