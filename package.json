{
  "name": "googoo-village-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "구구 마을 3D - 초등학교 2학년 곱셈구구 성장형 게임",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "art": "tsx --tsconfig tsconfig.scripts.json scripts/gen-art.ts",
    "model": "tsx --tsconfig tsconfig.scripts.json scripts/gen-model.ts",
    "audio": "tsx --tsconfig tsconfig.scripts.json scripts/build-audio.ts",
    "preview:lan": "vite build && vite preview --host --port 4173"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "meshoptimizer": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
